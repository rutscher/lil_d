---
interface Props {
  chapter: number;
  title: string;
}

const { chapter, title } = Astro.props;
---

<header class="chapter-header">
  <span class="chapter-badge">Chapter {chapter}</span>
  <h2 class="chapter-title">{title}</h2>
  <div class="chapter-flourish" aria-hidden="true">
    <svg viewBox="0 0 120 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 6h45M75 6h45" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="60" cy="6" r="4" fill="currentColor"/>
      <circle cx="52" cy="6" r="2" fill="currentColor" opacity="0.5"/>
      <circle cx="68" cy="6" r="2" fill="currentColor" opacity="0.5"/>
    </svg>
  </div>
</header>

<style>
  .chapter-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .chapter-badge {
    display: inline-block;
    background: var(--chapter-accent-light, var(--accent-blush-light));
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-sm);
  }

  .chapter-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--ink);
    margin-bottom: var(--space-md);
  }

  .chapter-flourish {
    width: 120px;
    margin: 0 auto;
    color: var(--chapter-accent, var(--accent-blush));
    opacity: 0.6;
  }

  .chapter-flourish svg {
    width: 100%;
    height: auto;
  }
</style>
