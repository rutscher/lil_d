---
import TbdBadge from './TbdBadge.astro';

interface Fact {
  label: string;
  value: string;
  isTbd?: boolean;
}

interface Props {
  known: Fact[];
  learning: Fact[];
}

const { known, learning } = Astro.props;
---

<div class="fact-grid">
  <div class="fact-column known">
    <h3 class="column-title">
      <span class="column-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
          <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </span>
      What We Know
    </h3>
    <ul class="fact-list">
      {known.map((fact) => (
        <li class="fact-item">
          <span class="fact-label">{fact.label}</span>
          <span class="fact-value">{fact.value}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="fact-column learning">
    <h3 class="column-title">
      <span class="column-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </span>
      Excited to Learn
    </h3>
    <ul class="fact-list">
      {learning.map((fact) => (
        <li class="fact-item">
          <span class="fact-label">{fact.label}</span>
          <span class="fact-value">
            {fact.value}
            {fact.isTbd && <TbdBadge variant="cute" />}
          </span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .fact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .fact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fact-column {
    background: var(--bg-alt);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .fact-column.known {
    border-left: 3px solid var(--accent-leaf);
  }

  .fact-column.learning {
    border-left: 3px solid var(--accent-butter);
  }

  .column-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-md);
  }

  .column-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ink-muted);
  }

  .column-icon svg {
    width: 100%;
    height: 100%;
  }

  .known .column-icon {
    color: var(--accent-leaf);
  }

  .learning .column-icon {
    color: var(--accent-butter);
  }

  .fact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid rgba(74, 63, 53, 0.08);
  }

  .fact-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .fact-item:first-child {
    padding-top: 0;
  }

  .fact-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    margin-bottom: var(--space-xs);
  }

  .fact-value {
    font-size: 1rem;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
