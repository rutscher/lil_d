---
interface Photo {
  src?: string;
  alt?: string;
  caption?: string;
  placeholder?: boolean;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<div class="polaroid-grid">
  {photos.map((photo, index) => (
    <div class:list={['polaroid', { placeholder: photo.placeholder }]} style={`--rotation: ${(index % 5 - 2) * 2}deg`}>
      <div class="polaroid-frame">
        {photo.placeholder ? (
          <div class="polaroid-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span>Photo coming soon</span>
          </div>
        ) : (
          <img src={photo.src} alt={photo.alt || 'Photo of Dorothy'} loading="lazy" />
        )}
      </div>
      <p class="polaroid-caption">{photo.caption || (photo.placeholder ? 'More memories to come!' : '')}</p>
    </div>
  ))}
</div>

<style>
  .polaroid-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-xl);
    padding: var(--space-md);
  }

  .polaroid {
    background: var(--paper);
    padding: var(--space-sm);
    padding-bottom: var(--space-xl);
    border-radius: var(--radius-sm);
    box-shadow: var(--paper-shadow);
    transform: rotate(var(--rotation, 0deg));
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .polaroid:hover {
    transform: rotate(0deg) scale(1.02);
    box-shadow: var(--paper-shadow-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .polaroid:hover {
      transform: rotate(var(--rotation, 0deg));
    }
  }

  .polaroid-frame {
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-alt);
  }

  .polaroid-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .polaroid-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    color: var(--ink-muted);
    background: linear-gradient(135deg, var(--bg-alt) 0%, var(--accent-butter-light) 100%);
  }

  .polaroid-placeholder svg {
    width: 3rem;
    height: 3rem;
    opacity: 0.4;
  }

  .polaroid-placeholder span {
    font-size: 0.75rem;
    font-weight: 600;
    text-align: center;
  }

  .polaroid-caption {
    font-size: 0.875rem;
    color: var(--ink);
    text-align: center;
    margin: var(--space-md) 0 0 0;
    font-family: var(--font-display);
  }

  .placeholder .polaroid-caption {
    color: var(--ink-muted);
    font-style: italic;
  }
</style>
